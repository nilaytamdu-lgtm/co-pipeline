[llm]
gemini_api_key = "YOUR_GEMINI_API_KEY"
anthropic_api_key = ""
openai_api_key = ""

[sheets]
spreadsheet_id = "GOOGLE_SHEET_ID_FROM_URL"

[google_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = ""
client_email = ""
client_id = ""
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = ""

[apis]
hunter_api_key = ""
brave_api_key = ""
snov_user_id = ""
snov_secret = ""
apollo_api_key = ""
# Skrapp issues one master API key. Free tier was 150/mo but newer free
# accounts may be locked out. Leave blank if you can't find an API page.
skrapp_api_key = ""
# GetProspect issues three separate scoped keys. We only need the first
# one for the enrichment chain. The other two are documented here in case
# we add support for them later.
getprospect_api_key = ""             # "Find email" scope — required for chain
getprospect_verify_key = ""          # "Verify email" scope — unused, optional
getprospect_linkedin_key = ""        # "Find contact by LinkedIn URL" — wire in on request
dropcontact_api_key = ""
